        >
          <span>🔄</span>
          <span>MAIN LAGI (PEMAIN SAMA)</span>
        </button>
        <div class="grid grid-cols-2 gap-3">
          <button
            onclick="showScreen('leaderboard')"
            class="btn-3d py-3 px-4 rounded-2xl bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold text-sm sm:text-base border-b-4 border-amber-600"
          >
            🏆 Leaderboard
          </button>
          <button
            onclick="showScreen('start')"
            class="btn-3d py-3 px-4 rounded-2xl bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold text-sm sm:text-base border-b-4 border-slate-400"
          >
            🏠 Menu Utama
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       SCREEN 4: LEADERBOARD SCREEN (PAPAN PERINGKAT LOCALSTORAGE)
       ========================================================= -->
  <section id="screen-leaderboard" class="hidden flex-1 flex items-center justify-center p-4">
    <div class="w-full max-w-2xl bg-white border-4 border-amber-400 rounded-[2rem] p-5 sm:p-7 shadow-2xl">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-6">
