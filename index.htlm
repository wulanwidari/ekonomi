      <!-- Feedback & Explanation Box (Hidden until answered) -->
      <div id="quiz-feedback" class="hidden mt-4 p-4 rounded-2xl border-2">
        <div class="flex items-center gap-2 mb-1.5">
          <span id="quiz-feedback-icon" class="text-2xl">✅</span>
          <h4 id="quiz-feedback-title" class="font-extrabold text-base sm:text-lg">Jawaban Benar!</h4>
