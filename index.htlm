  <!-- =========================================================
       JAVASCRIPT: AUDIO, BANK SOAL, LOGIKA PAPAN & GAMEPLAY
       ========================================================= -->
  <script>
    /* ===========================================================
       1. WEB AUDIO API SOUND ENGINE (Tanpa URL Eksternal)
       =========================================================== */
    const SoundFX = {
      ctx: null,
      muted: false,

      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      },

      playTone(freq, type = 'sine', duration = 0.15, delay = 0, gainVal = 0.18) {
        if (this.muted) return;
        try {
          this.init();
          if (!this.ctx) return;
          const now = this.ctx.currentTime + delay;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, now);

          gain.gain.setValueAtTime(gainVal, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + duration);
        } catch (e) {
          // Abaikan jika browser membatasi audio
        }
      },

      roll() {
        // Efek suara kocok dadu beruntun
        for (let i = 0; i < 6; i++) {
          this.playTone(220 + Math.random() * 240, 'triangle', 0.06, i * 0.075, 0.15);
        }
      },

      step() {
        // Efek langkah pion melompat
        this.playTone(440, 'sine', 0.09, 0, 0.16);
        this.playTone(580, 'sine', 0.08, 0.04, 0.12);
      },

      correct() {
        // Melodi ceria jawaban benar
        this.playTone(523.25, 'triangle', 0.14, 0, 0.22);    // C5
        this.playTone(659.25, 'triangle', 0.14, 0.11, 0.22); // E5
        this.playTone(783.99, 'triangle', 0.25, 0.22, 0.25); // G5
      },

      wrong() {
        // Nada turun jawaban salah
        this.playTone(310, 'sawtooth', 0.18, 0, 0.15);
        this.playTone(245, 'sawtooth', 0.28, 0.16, 0.15);
      },

      ladder() {
        // Arpeggio naik tangga untung
        const notes = [392, 440, 493.88, 587.33, 659.25, 783.99];
        notes.forEach((n, idx) => this.playTone(n, 'sine', 0.12, idx * 0.07, 0.2));
      },

      snake() {
        // Efek meluncur turun ular rugi
        const notes = [620, 540, 460, 380, 300, 220];
        notes.forEach((n, idx) => this.playTone(n, 'sawtooth', 0.11, idx * 0.07, 0.14));
      },

      win() {
        // Fanfare kemenangan
        const melody = [
          { f: 523.25, d: 0.15, t: 0 },
          { f: 523.25, d: 0.15, t: 0.16 },
          { f: 523.25, d: 0.15, t: 0.32 },
          { f: 659.25, d: 0.35, t: 0.48 },
          { f: 587.33, d: 0.20, t: 0.86 },
          { f: 659.25, d: 0.20, t: 1.08 },
          { f: 783.99, d: 0.55, t: 1.30 }
        ];
        melody.forEach(m => this.playTone(m.f, 'triangle', m.d, m.t, 0.25));
      }
    };

    function toggleMute() {
      SoundFX.muted = !SoundFX.muted;
      const btn = document.getElementById('btn-sound');
      btn.textContent = SoundFX.muted ? '🔇' : '🔊';
      showToast(SoundFX.muted ? 'Suara dimatikan' : 'Suara diaktifkan', 'info');
    }

    /* ===========================================================
       2. BANK SOAL IPS: HUKUM EKONOMI (28 VARIASI SOAL BERKUALITAS)
       =========================================================== */
    const QUESTION_BANK = [
      {
        topic: 'Hukum Permintaan',
        question: 'Menurut Hukum Permintaan, apabila harga suatu barang mengalami kenaikan (dengan asumsi ceteris paribus), maka jumlah barang yang diminta oleh konsumen akan...',
        options: [
          'Meningkat drastis',
          'Menurun atau berkurang',
          'Tetap tidak berubah',
          'Sama dengan jumlah penawaran'
        ],
        correctIndex: 1,
        explanation: 'Hukum Permintaan menyatakan hubungan berbanding terbalik antara harga dan jumlah barang yang diminta: jika harga naik, jumlah permintaan turun (ceteris paribus).'
      },
      {
        topic: 'Hukum Penawaran',
        question: 'Ketika harga cabai rawit di pasar melonjak tinggi, para petani dan pedagang berlomba-lomba menjual lebih banyak cabai. Fenomena ini sesuai dengan...',
        options: [
          'Hukum Permintaan',
          'Hukum Gossen I',
          'Hukum Penawaran',
          'Hukum Engel'
        ],
        correctIndex: 2,
        explanation: 'Hukum Penawaran menyatakan bahwa semakin tinggi harga suatu barang, semakin banyak jumlah barang yang ditawarkan produsen untuk meraih keuntungan lebih besar.'
      },
      {
        topic: 'Ceteris Paribus',
        question: 'Dalam kajian hukum ekonomi, istilah "ceteris paribus" memiliki arti...',
        options: [
          'Semua harga barang ditentukan pemerintah',
          'Faktor-faktor lain di luar harga dianggap tetap',
          'Kebutuhan manusia tidak terbatas',
          'Pasar berada dalam kondisi monopoli'
        ],
        correctIndex: 1,
        explanation: 'Ceteris paribus berarti faktor-faktor lain selain harga barang itu sendiri (seperti pendapatan, selera, dan harga barang lain) dianggap tetap atau tidak berubah.'
      },
      {
        topic: 'Hukum Gossen I',
        question: 'Rafi sangat kehausan setelah berolahraga. Gelas es teh pertama terasa sangat nikmat, gelas kedua cukup nikmat, namun pada gelas keempat ia mulai merasa kenyang dan enek. Peristiwa ini menggambarkan...',
        options: [
          'Hukum Gossen I (Law of Diminishing Marginal Utility)',
          'Hukum Gossen II',
          'Hukum Penawaran Pasar',
          'Hukum Keseimbangan Harga'
        ],
        correctIndex: 0,
        explanation: 'Hukum Gossen I menyatakan bahwa jika pemenuhan suatu kebutuhan dilakukan secara terus-menerus, kenikmatannya mula-mula tinggi namun semakin lama semakin menurun hingga mencapai titik jenuh.'
      },
      {
        topic: 'Hukum Gossen II',
        question: 'Ibu Sari memiliki uang Rp100.000 dan membelanjakannya untuk membeli beras, lauk pauk, dan sabun secara proporsional agar seluruh kebutuhannya terpenuhi pada tingkat kepuasan yang seimbang. Prinsip ini sesuai dengan...',
        options: [
          'Hukum Engel',
          'Hukum Gossen II',
          'Hukum Permintaan Efektif',
          'Hukum Hasil Lebih yang Semakin Berkurang'
        ],
        correctIndex: 1,
        explanation: 'Hukum Gossen II menjelaskan bahwa manusia berusaha memenuhi berbagai macam kebutuhan yang beraneka ragam sampai pada tingkat intensitas atau kepuasan yang sama.'
      },
      {
        topic: 'Hukum Engel',
        question: 'Menurut Hukum Engel, apabila pendapatan suatu keluarga meningkat tajam, maka persentase pengeluaran pendapatan untuk kebutuhan pangan (makanan pokok) akan...',
        options: [
          'Semakin besar',
          'Semakin kecil (beralih ke kebutuhan sekunder/tersier)',
          'Selalu 100% dari pendapatan',
          'Sama dengan pengeluaran pajak'
        ],
        correctIndex: 1,
        explanation: 'Hukum Engel menyatakan bahwa semakin tinggi tingkat pendapatan rumah tangga, semakin kecil persentase pendapatan yang digunakan untuk konsumsi makanan pokok.'
      },
      {
        topic: 'Kurva Permintaan',
        question: 'Bentuk kurva permintaan (Demand Curve) pada umumnya digambarkan bergerak miring dari...',
        options: [
          'Kiri bawah ke kanan atas (berslope positif)',
          'Kiri atas ke kanan bawah (berslope negatif)',
          'Horizontal sejajar sumbu jumlah barang',
          'Vertikal sejajar sumbu harga'
        ],
        correctIndex: 1,
        explanation: 'Kurva permintaan miring dari kiri atas ke kanan bawah (slope negatif) karena hubungan antara harga (P) dan jumlah diminta (Qd) berbanding terbalik.'
      },
      {
        topic: 'Kurva Penawaran',
        question: 'Mengapa kurva penawaran (Supply Curve) bergerak miring dari kiri bawah ke kanan atas?',
        options: [
          'Karena harga dan jumlah yang ditawarkan berbanding lurus',
          'Karena pembeli menyukai harga yang mahal',
          'Karena biaya produksi selalu turun',
          'Karena jumlah barang di alam tidak terbatas'
        ],
        correctIndex: 0,
        explanation: 'Kurva penawaran berslope positif (kiri bawah ke kanan atas) karena hubungan antara harga dan jumlah barang yang ditawarkan berbanding lurus.'
      },
      {
        topic: 'Keseimbangan Pasar',
        question: 'Harga keseimbangan pasar (equilibrium price) terbentuk pada saat...',
        options: [
          'Jumlah permintaan lebih besar dari penawaran',
          'Jumlah penawaran jauh melebihi permintaan',
          'Jumlah barang yang diminta sama dengan jumlah barang yang ditawarkan (Qd = Qs)',
          'Pemerintah melarang transaksi jual beli'
        ],
        correctIndex: 2,
        explanation: 'Harga keseimbangan pasar terjadi ketika kurva permintaan berpotongan dengan kurva penawaran, yaitu saat jumlah permintaan sama dengan jumlah penawaran (Qd = Qs).'
      },
      {
        topic: 'Studi Kasus Permintaan',
        question: 'Sebuah toko sepatu mengadakan diskon besar-besaran sebesar 50% menjelang tahun ajaran baru sehingga pengunjung membeludak. Faktor utama yang menyebabkan lonjakan jumlah permintaan tersebut adalah...',
        options: [
          'Penurunan harga barang itu sendiri',
          'Kenaikan biaya bahan baku kulit',
          'Penurunan jumlah penduduk',
          'Kelangkaan tenaga kerja'
        ],
        correctIndex: 0,
        explanation: 'Sesuai Hukum Permintaan, penurunan harga barang (melalui diskon 50%) menyebabkan kuantitas barang yang diminta konsumen meningkat.'
      },
      {
        topic: 'Pengecualian Hukum Permintaan',
        question: 'Pada barang mewah berstatus sosial tinggi seperti berlian langka atau lukisan antik (barang Veblen), terkadang semakin mahal harganya justru semakin diburu kolektor. Hal ini terjadi karena...',
        options: [
          'Berlian merupakan kebutuhan pokok harian',
          'Harga mahal dianggap menunjukkan prestise dan gengsi sosial',
          'Persediaan lukisan antik sangat melimpah',
          'Tidak ada pembeli di pasar'
        ],
        correctIndex: 1,
        explanation: 'Barang prestise (efek Veblen) merupakan pengecualian hukum permintaan karena nilai gengsi sosialnya justru naik saat harganya tinggi.'
      },
      {
        topic: 'Kelebihan Permintaan',
        question: 'Apabila harga pasar ditetapkan terlalu rendah di bawah harga keseimbangan, maka yang akan terjadi di pasar adalah...',
        options: [
          'Kelebihan penawaran (excess supply) sehingga barang menumpuk',
          'Kelebihan permintaan (excess demand) sehingga terjadi kelangkaan barang',
          'Produsen mendapat keuntungan maksimal',
          'Permintaan menjadi nol'
        ],
        correctIndex: 1,
        explanation: 'Jika harga di bawah titik keseimbangan, banyak konsumen ingin membeli namun produsen enggan menjual, memicu excess demand (kelangkaan).'
      },
      {
        topic: 'Kelebihan Penawaran',
        question: 'Saat panen raya mangga melimpah ruah sedangkan daya beli masyarakat tetap, harga mangga di pasar cenderung turun. Kondisi awal sebelum harga turun disebut...',
        options: [
          'Excess supply (kelebihan penawaran)',
          'Excess demand (kelebihan permintaan)',
          'Titik jenuh Gossen',
          'Inflasi biaya produksi'
        ],
        correctIndex: 0,
        explanation: 'Panen raya meningkatkan jumlah penawaran melebihi jumlah permintaan (excess supply), yang akhirnya mendorong harga turun menuju keseimbangan baru.'
      },
      {
        topic: 'Pergeseran Kurva Permintaan',
        question: 'Jika pendapatan rata-rata masyarakat meningkat pesat, maka kurva permintaan terhadap barang normal (seperti pakaian dan elektronik) akan...',
        options: [
          'Bergeser ke kanan atas',
          'Bergeser ke kiri bawah',
          'Tidak mengalami pergeseran sama sekali',
          'Berubah menjadi garis lurus vertikal'
        ],
        correctIndex: 0,
        explanation: 'Kenaikan pendapatan meningkatkan daya beli pada setiap tingkat harga sehingga kurva permintaan bergeser ke kanan.'
      },
      {
        topic: 'Pergeseran Kurva Penawaran',
        question: 'Penggunaan mesin teknologi modern di pabrik roti membuat produksi menjadi lebih cepat dan biaya per unit lebih murah. Dampaknya terhadap kurva penawaran roti adalah...',
        options: [
          'Kurva penawaran bergeser ke kiri',
          'Kurva penawaran bergeser ke kanan',
          'Kurva permintaan bergeser ke kiri',
          'Harga roti pasti naik dua kali lipat'
        ],
        correctIndex: 1,
        explanation: 'Efisiensi teknologi menurunkan biaya produksi sehingga produsen mampu menawarkan lebih banyak barang pada setiap tingkat harga (kurva penawaran bergeser ke kanan).'
      },
      {
        topic: 'Hukum Gossen I',
        question: 'Nilai kepuasan tambahan yang diperoleh konsumen ketika menambah satu unit barang yang dikonsumsi disebut...',
        options: [
          'Total Utility (Nilai Guna Total)',
          'Marginal Utility (Nilai Guna Marginal)',
          'Exchange Value (Nilai Tukar)',
          'Equilibrium Value (Nilai Keseimbangan)'
        ],
        correctIndex: 1,
        explanation: 'Marginal Utility (nilai guna marginal) adalah tambahan kepuasan dari mengonsumsi satu unit tambahan barang, yang menurut Hukum Gossen I semakin lama semakin menurun.'
      },
      {
        topic: 'Barang Substitusi',
        question: 'Apabila harga daging ayam naik tajam, banyak ibu rumah tangga beralih membeli ikan atau telur sebagai penggantinya. Dalam ilmu ekonomi, hubungan antara daging ayam dan ikan disebut...',
        options: [
          'Barang komplementer (pelengkap)',
          'Barang substitusi (pengganti)',
          'Barang bebas',
          'Barang modal'
        ],
        correctIndex: 1,
        explanation: 'Barang substitusi adalah barang yang dapat saling menggantikan fungsinya; jika harga barang A naik, permintaan barang penggantinya (B) akan naik.'
      },
      {
        topic: 'Barang Komplementer',
        question: 'Harga bahan bakar bensin mengalami kenaikan signifikan. Menurut analisis permintaan barang komplementer, hal ini berpotensi membuat permintaan kendaraan bermotor berbahan bakar bensin menjadi...',
        options: [
          'Menurun',
          'Meningkat pesat',
          'Tidak terpengaruh sama sekali',
          'Berubah menjadi barang bebas'
        ],
        correctIndex: 0,
        explanation: 'Bensin dan motor berbahan bakar bensin adalah barang komplementer (saling melengkapi); jika harga bensin naik, permintaan motor cenderung menurun.'
      },
      {
        topic: 'Jenis Permintaan',
        question: 'Dina ingin sekali membeli laptop baru untuk belajar desain, dan ia sudah memiliki uang tabungan yang cukup untuk membelinya hari ini. Permintaan Dina tergolong sebagai...',
        options: [
          'Permintaan absolut',
          'Permintaan potensial',
          'Permintaan efektif',
          'Permintaan kolektif'
        ],
        correctIndex: 2,
        explanation: 'Permintaan efektif adalah permintaan terhadap suatu barang atau jasa yang disertai dengan kemampuan membayar (daya beli).'
      },
      {
