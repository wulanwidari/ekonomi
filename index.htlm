      {
        topic: 'Hukum Gossen I',
        question: 'Titik di mana konsumsi suatu barang mencapai kepuasan total tertinggi dan nilai guna marginal (tambahan kepuasan) bernilai nol disebut...',
        options: [
          'Titik keseimbangan pasar',
          'Titik jenuh (saturation point)',
          'Titik impas (break-even point)',
          'Titik inflasi'
        ],
        correctIndex: 1,
        explanation: 'Pada titik jenuh (Hukum Gossen I), tambahan kepuasan (marginal utility) bernilai nol; jika konsumsi terus ditambah setelah titik ini, kepuasan justru menjadi negatif.'
      },
      {
        topic: 'Subsidi & Penawaran',
        question: 'Pemerintah memberikan subsidi pupuk kepada petani padi. Kebijakan subsidi ini akan meringankan biaya produksi petani sehingga kurva penawaran beras akan...',
        options: [
          'Bergeser ke kanan (penawaran meningkat)',
          'Bergeser ke kiri (penawaran menurun)',
          'Menghilang dari pasar',
          'Menyebabkan harga beras melambung tinggi'
        ],
        correctIndex: 0,
        explanation: 'Subsidi menurunkan biaya produksi sehingga produsen mampu meningkatkan jumlah barang yang ditawarkan (kurva penawaran bergeser ke kanan).'
      },
      {
        topic: 'Hukum Ekonomi',
        question: 'Hubungan sebab-akibat atau keterkaitan antara peristiwa-peristiwa ekonomi yang saling berhubungan dan berlaku secara umum disebut...',
        options: [
          'Motif ekonomi',
          'Tindakan ekonomi',
          'Hukum ekonomi',
          'Politik ekonomi'
        ],
        correctIndex: 2,
        explanation: 'Hukum ekonomi adalah hubungan kausal (sebab-akibat) antara gejala-gejala ekonomi yang saling berkaitan, seperti hubungan antara harga dan permintaan.'
      },
      {
        topic: 'Studi Kasus Penawaran',
        question: 'Menjelang Hari Raya Idulfitri, harga kue kering di toko meningkat karena banyaknya pesanan, sehingga produsen kue menambah jam kerja lembur untuk memproduksi lebih banyak kue. Perilaku produsen tersebut mencerminkan...',
        options: [
          'Hukum Penawaran',
          'Hukum Gossen II',
          'Hukum Engel',
          'Permintaan Absolut'
        ],
        correctIndex: 0,
        explanation: 'Kenaikan harga jual mendorong produsen menambah jumlah barang yang ditawarkan ke pasar sesuai dengan Hukum Penawaran.'
      }
    ];

    /* ===========================================================
       3. KONFIGURASI PAPAN 5x5 ZIG-ZAG, TANGGA & ULAR
       =========================================================== */
    const BOARD_SIZE = 5;
    const TOTAL_TILES = 25;

    // Rute Tangga (Naik / Peluang Untung)
    const LADDERS = {
      3: 11,
      6: 15,
      12: 22
    };

    // Rute Ular (Turun / Risiko Rugi)
    const SNAKES = {
      14: 4,
      19: 9,
      24: 16
    };

    const LEADERBOARD_KEY = 'juragan_ekonomi_leaderboard_v1';

    /* ===========================================================
       4. STATE PERMAINAN
       =========================================================== */
    let gameState = {
      team: '',
      players: [
        { id: 0, name: 'Pemain 1', color: 'red', pos: 1, rolls: 0, correct: 0, score: 0 },
        { id: 1, name: 'Pemain 2', color: 'blue', pos: 1, rolls: 0, correct: 0, score: 0 }
      ],
      currentPlayerIndex: 0,
      isBusy: false, // Mencegah klik ganda saat animasi dadu/langkah/kuis
      usedQuestionIndices: [],
      pendingQuizContext: null // Menyimpan detail aksi setelah kuis dijawab
    };

    /* ===========================================================
       5. UTILITAS UI: TOAST & MODAL KONFIRMASI
       =========================================================== */
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = {
        info: 'bg-indigo-600 text-white border-indigo-800',
        success: 'bg-emerald-600 text-white border-emerald-800',
        warning: 'bg-amber-500 text-amber-950 border-amber-700',
        error: 'bg-rose-600 text-white border-rose-800'
      };
      toast.className = `px-4 py-3 rounded-2xl border-b-4 shadow-xl font-bold text-sm text-center animate-pop ${colors[type] || colors.info}`;
      toast.textContent = message;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-10px)';
        toast.style.transition = 'all 0.25s ease';
        setTimeout(() => toast.remove(), 260);
      }, 2600);
    }

    function showConfirmModal(title, message, onConfirm) {
      const modal = document.getElementById('modal-confirm');
      document.getElementById('confirm-title').textContent = title;
      document.getElementById('confirm-message').textContent = message;
      modal.classList.remove('hidden');
      modal.classList.add('flex');

      const btnOk = document.getElementById('confirm-ok');
      const btnCancel = document.getElementById('confirm-cancel');

      const cleanup = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      btnCancel.onclick = cleanup;
      btnOk.onclick = () => {
        cleanup();
        onConfirm();
      };
    }

    function toggleRulesModal(show) {
      const modal = document.getElementById('modal-rules');
      if (show) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      } else {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    /* ===========================================================
       6. NAVIGASI ANTAR HALAMAN (START, GAME, GAMEOVER, LEADERBOARD)
       =========================================================== */
    function showScreen(screenName) {
      const screens = ['start', 'game', 'gameover', 'leaderboard'];
      screens.forEach(s => {
        const el = document.getElementById(`screen-${s}`);
        if (s === screenName) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      if (screenName === 'game') {
        setTimeout(() => {
          drawSnakesAndLaddersSVG();
          updatePawnsPosition();
        }, 50);
      } else if (screenName === 'leaderboard') {
        renderLeaderboard();
      }
    }

    function confirmExitGame() {
      showConfirmModal(
        'Keluar ke Menu Utama?',
        'Progres permainan saat ini akan dihentikan. Yakin ingin kembali ke halaman awal?',
        () => showScreen('start')
      );
    }

    /* ===========================================================
       7. PEMBUATAN PAPAN 5x5 ZIG-ZAG & SVG ULAR TANGGA
       =========================================================== */
    // Mengubah nomor kotak (1..25) menjadi koordinat baris (0=atas..4=bawah) & kolom (0=kiri..4=kanan)
    function getTileRowCol(tileNum) {
      const zeroIdx = tileNum - 1;
      const rowFromBottom = Math.floor(zeroIdx / BOARD_SIZE); // 0..4
      const row = (BOARD_SIZE - 1) - rowFromBottom; // 4..0
      let col = zeroIdx % BOARD_SIZE;
      // Baris ganjil dari bawah (rowFromBottom = 1, 3) bergerak dari kanan ke kiri (zig-zag)
      if (rowFromBottom % 2 === 1) {
        col = (BOARD_SIZE - 1) - col;
      }
      return { row, col };
    }

    function buildBoardGrid() {
      const grid = document.getElementById('board-grid');
      grid.innerHTML = '';

      // Buat matriks 5x5 agar mudah dirender dari baris atas (0) ke bawah (4)
      const matrix = Array.from({ length: BOARD_SIZE }, () => Array(BOARD_SIZE).fill(0));
      for (let num = 1; num <= TOTAL_TILES; num++) {
        const { row, col } = getTileRowCol(num);
        matrix[row][col] = num;
      }

      const tileColors = [
        'bg-amber-50',
        'bg-orange-100/80',
        'bg-yellow-100/80',
        'bg-emerald-50',
        'bg-sky-50'
      ];

      for (let r = 0; r < BOARD_SIZE; r++) {
        for (let c = 0; c < BOARD_SIZE; c++) {
          const num = matrix[r][c];
          const isLadder = LADDERS[num] !== undefined;
          const isSnake = SNAKES[num] !== undefined;
          const isStart = num === 1;
          const isFinish = num === 25;

          const cell = document.createElement('div');
          cell.id = `tile-${num}`;

          let bgClass = tileColors[(r + c) % tileColors.length];
          if (isStart) bgClass = 'bg-indigo-200';
          if (isFinish) bgClass = 'bg-gradient-to-br from-amber-300 to-yellow-400';
          if (isLadder) bgClass = 'bg-emerald-100';
          if (isSnake) bgClass = 'bg-rose-100';

          cell.className = `relative border border-amber-400/70 flex flex-col justify-between p-1 sm:p-1.5 select-none ${bgClass}`;

          // Nomor kotak & ikon spesial
          let badgeHTML = `<span class="text-xs sm:text-sm font-extrabold text-slate-700 leading-none">${num}</span>`;
          let centerIcon = '';

          if (isStart) {
            badgeHTML = `<span class="text-[10px] sm:text-xs font-extrabold text-indigo-800 bg-white/80 px-1 rounded">1 START</span>`;
            centerIcon = `<span class="text-base sm:text-xl opacity-80 self-center">🚀</span>`;
          } else if (isFinish) {
            badgeHTML = `<span class="text-[10px] sm:text-xs font-extrabold text-amber-950 bg-white/80 px-1 rounded">25 GOL!</span>`;
            centerIcon = `<span class="text-lg sm:text-2xl self-center">🏆</span>`;
          } else if (isLadder) {
            badgeHTML = `
              <div class="flex items-center justify-between w-full">
                <span class="text-xs sm:text-sm font-extrabold text-emerald-800">${num}</span>
                <span class="text-[10px] sm:text-xs font-bold bg-emerald-500 text-white px-1 rounded-md">⭐📈</span>
              </div>`;
          } else if (isSnake) {
            badgeHTML = `
              <div class="flex items-center justify-between w-full">
                <span class="text-xs sm:text-sm font-extrabold text-rose-800">${num}</span>
                <span class="text-[10px] sm:text-xs font-bold bg-rose-500 text-white px-1 rounded-md">⭐📉</span>
              </div>`;
          }

          cell.innerHTML = `${badgeHTML}${centerIcon}<div class="h-2"></div>`;
          grid.appendChild(cell);
        }
      }

      createPawns();
      drawSnakesAndLaddersSVG();
      updatePawnsPosition();
    }

    // Menggambar SVG Tangga (Hijau/Emas) & Ular (Merah/Ungu) secara presisi di atas papan
    function drawSnakesAndLaddersSVG() {
      const svg = document.getElementById('board-svg');
      const wrapper = document.getElementById('board-wrapper');
      if (!svg || !wrapper) return;

      const width = wrapper.clientWidth;
      const height = wrapper.clientHeight;
      if (width === 0 || height === 0) return;

      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.innerHTML = '';

      const getTileCenter = (tileNum) => {
        const { row, col } = getTileRowCol(tileNum);
        const cellW = width / BOARD_SIZE;
        const cellH = height / BOARD_SIZE;
        return {
          x: (col + 0.5) * cellW,
          y: (row + 0.5) * cellH
        };
      };

      // 1. Gambar Semua Tangga (Ladders)
      Object.entries(LADDERS).forEach(([startStr, endNum]) => {
        const p1 = getTileCenter(Number(startStr));
        const p2 = getTileCenter(Number(endNum));

        const dx = p2.x - p1.x;
        const dy = p2.y - p1.y;
        const len = Math.hypot(dx, dy);
        const nx = (-dy / len) * 9; // Lebar setengah tangga
        const ny = (dx / len) * 9;

        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.setAttribute('opacity', '0.88');

        // Dua tiang tangga samping
        const rail1 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        rail1.setAttribute('x1', p1.x + nx);
        rail1.setAttribute('y1', p1.y + ny);
        rail1.setAttribute('x2', p2.x + nx);
        rail1.setAttribute('y2', p2.y + ny);
        rail1.setAttribute('stroke', '#059669');
        rail1.setAttribute('stroke-width', '4.5');
        rail1.setAttribute('stroke-linecap', 'round');

        const rail2 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        rail2.setAttribute('x1', p1.x - nx);
        rail2.setAttribute('y1', p1.y - ny);
        rail2.setAttribute('x2', p2.x - nx);
        rail2.setAttribute('y2', p2.y - ny);
        rail2.setAttribute('stroke', '#059669');
        rail2.setAttribute('stroke-width', '4.5');
        rail2.setAttribute('stroke-linecap', 'round');

        g.appendChild(rail1);
        g.appendChild(rail2);

        // Anak tangga (rungs)
        const steps = Math.max(4, Math.floor(len / 18));
        for (let i = 1; i < steps; i++) {
          const t = i / steps;
          const rx = p1.x + dx * t;
          const ry = p1.y + dy * t;
          const rung = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          rung.setAttribute('x1', rx + nx);
          rung.setAttribute('y1', ry + ny);
          rung.setAttribute('x2', rx - nx);
          rung.setAttribute('y2', ry - ny);
          rung.setAttribute('stroke', '#FBBF24');
          rung.setAttribute('stroke-width', '3.5');
          rung.setAttribute('stroke-linecap', 'round');
          g.appendChild(rung);
        }

        svg.appendChild(g);
      });

      // 2. Gambar Semua Ular (Snakes) berkelok
      Object.entries(SNAKES).forEach(([headStr, tailNum]) => {
        const p1 = getTileCenter(Number(headStr)); // Kepala ular
        const p2 = getTileCenter(Number(tailNum)); // Ekor ular

        const midX = (p1.x + p2.x) / 2;
        const midY = (p1.y + p2.y) / 2;
        const dx = p2.x - p1.x;
        const dy = p2.y - p1.y;
        const perpX = -dy * 0.25;
        const perpY = dx * 0.25;

        const ctrl1X = (p1.x + midX) / 2 + perpX;
        const ctrl1Y = (p1.y + midY) / 2 + perpY;
        const ctrl2X = (midX + p2.x) / 2 - perpX;
        const ctrl2Y = (midY + p2.y) / 2 - perpY;

        const pathData = `M ${p1.x} ${p1.y} Q ${ctrl1X} ${ctrl1Y}, ${midX} ${midY} T ${p2.x} ${p2.y}`;

        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.setAttribute('opacity', '0.88');

        // Badan ular luar
        const bodyOuter = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        bodyOuter.setAttribute('d', pathData);
        bodyOuter.setAttribute('fill', 'none');
        bodyOuter.setAttribute('stroke', '#E11D48');
        bodyOuter.setAttribute('stroke-width', '9');
        bodyOuter.setAttribute('stroke-linecap', 'round');

        // Corak garis dalam ular
        const bodyInner = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        bodyInner.setAttribute('d', pathData);
        bodyInner.setAttribute('fill', 'none');
        bodyInner.setAttribute('stroke', '#FDA4AF');
        bodyInner.setAttribute('stroke-width', '3.5');
        bodyInner.setAttribute('stroke-dasharray', '6 6');
        bodyInner.setAttribute('stroke-linecap', 'round');

        // Kepala ular
        const head = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        head.setAttribute('cx', p1.x);
        head.setAttribute('cy', p1.y);
        head.setAttribute('r', '9');
        head.setAttribute('fill', '#BE123C');

        // Mata ular
        const eyeL = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        eyeL.setAttribute('cx', p1.x - 3);
        eyeL.setAttribute('cy', p1.y - 2);
        eyeL.setAttribute('r', '2');
        eyeL.setAttribute('fill', '#FFF');

        const eyeR = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        eyeR.setAttribute('cx', p1.x + 3);
        eyeR.setAttribute('cy', p1.y - 2);
        eyeR.setAttribute('r', '2');
        eyeR.setAttribute('fill', '#FFF');

        g.appendChild(bodyOuter);
        g.appendChild(bodyInner);
        g.appendChild(head);
        g.appendChild(eyeL);
        g.appendChild(eyeR);
        svg.appendChild(g);
      });
    }

    // Membuat Elemen Pion Pemain 1 & 2
    function createPawns() {
      const layer = document.getElementById('pawn-layer');
      layer.innerHTML = `
        <div id="pawn-0" class="pawn-piece absolute w-8 h-8 sm:w-10 sm:h-10 -ml-4 -mt-4 sm:-ml-5 sm:-mt-5 rounded-full bg-gradient-to-br from-rose-400 to-rose-600 border-3 border-white flex items-center justify-center text-white font-extrabold text-xs sm:text-sm shadow-lg">
          P1
        </div>
        <div id="pawn-1" class="pawn-piece absolute w-8 h-8 sm:w-10 sm:h-10 -ml-4 -mt-4 sm:-ml-5 sm:-mt-5 rounded-full bg-gradient-to-br from-sky-400 to-sky-600 border-3 border-white flex items-center justify-center text-white font-extrabold text-xs sm:text-sm shadow-lg">
          P2
        </div>
      `;
    }

    // Memperbarui Posisi Pion Real-time di Atas Papan
    function updatePawnsPosition() {
      const wrapper = document.getElementById('board-wrapper');
      if (!wrapper) return;
      const w = wrapper.clientWidth;
      const h = wrapper.clientHeight;
      if (w === 0 || h === 0) return;

      const sameTile = gameState.players[0].pos === gameState.players[1].pos;

      gameState.players.forEach((player, idx) => {
        const pawnEl = document.getElementById(`pawn-${idx}`);
        if (!pawnEl) return;

        const { row, col } = getTileRowCol(player.pos);
        const cellW = w / BOARD_SIZE;
        const cellH = h / BOARD_SIZE;

        // Jika dua pion berada di kotak yang sama, geser sedikit agar tidak saling menutupi
        const offsetX = sameTile ? (idx === 0 ? -9 : 9) : 0;
        const offsetY = sameTile ? (idx === 0 ? -4 : 4) : 0;

        const targetX = (col + 0.5) * cellW + offsetX;
        const targetY = (row + 0.55) * cellH + offsetY;

        pawnEl.style.transform = `translate(${targetX}px, ${targetY}px)`;
      });
    }

    window.addEventListener('resize', () => {
      if (!document.getElementById('screen-game').classList.contains('hidden')) {
        drawSnakesAndLaddersSVG();
        updatePawnsPosition();
      }
    });

    /* ===========================================================
       8. VISUAL DADU & MEKANIKA LEMPAR DADU
       =========================================================== */
    function renderDiceFace(value) {
      const face = document.getElementById('dice-face');
      // Pola titik dadu 3x3 (indeks 0..8)
      const pipMap = {
        1: [4],
        2: [2, 6],
        3: [2, 4, 6],
        4: [0, 2, 6, 8],
        5: [0, 2, 4, 6, 8],
        6: [0, 2, 3, 5, 6, 8]
      };
      const activePips = pipMap[value] || [4];
      const dotColor = value === 6 ? 'bg-rose-500' : 'bg-slate-800';

      face.innerHTML = '';
      for (let i = 0; i < 9; i++) {
        const cell = document.createElement('div');
        cell.className = 'flex items-center justify-center';
        if (activePips.includes(i)) {
          cell.innerHTML = `<span class="w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full ${dotColor} shadow-inner"></span>`;
        }
        face.appendChild(cell);
      }
    }

    // Inisialisasi permainan baru dari Form Start Screen
    document.getElementById('start-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const p1Name = document.getElementById('input-p1').value.trim();
      const p2Name = document.getElementById('input-p2').value.trim();
      const teamName = document.getElementById('input-team').value.trim();

      if (!p1Name || !p2Name || !teamName) {
        showToast('Mohon lengkapi nama Pemain 1, Pemain 2, dan Kelas/Sekolah!', 'warning');
        return;
      }

      SoundFX.init();
      startNewMatch(p1Name, p2Name, teamName);
    });

    function startNewMatch(p1Name, p2Name, teamName) {
      gameState = {
        team: teamName,
        players: [
          { id: 0, name: p1Name, color: 'red', pos: 1, rolls: 0, correct: 0, score: 0 },
          { id: 1, name: p2Name, color: 'blue', pos: 1, rolls: 0, correct: 0, score: 0 }
        ],
        currentPlayerIndex: 0,
        isBusy: false,
        usedQuestionIndices: [],
        pendingQuizContext: null
      };

      document.getElementById('hud-team').textContent = teamName;
      document.getElementById('p1-name-display').textContent = p1Name;
      document.getElementById('p2-name-display').textContent = p2Name;

      renderDiceFace(6);
      buildBoardGrid();
      updateHUD();
      setLog(`Permainan dimulai! Giliran ${p1Name} (Merah) untuk mengocok dadu pertama.`);
      showScreen('game');
    }

    function restartSamePlayers() {
      startNewMatch(
        gameState.players[0].name,
        gameState.players[1].name,
        gameState.team
      );
    }

    function setLog(text) {
      document.getElementById('game-log').textContent = text;
    }

    function updateHUD() {
      const p1 = gameState.players[0];
      const p2 = gameState.players[1];
      const active = gameState.players[gameState.currentPlayerIndex];

      // Update statistik masing-masing kartu pemain
      document.getElementById('p1-tile-badge').textContent = `Kotak ${p1.pos}/25`;
      document.getElementById('p1-rolls').textContent = p1.rolls;
      document.getElementById('p1-correct').textContent = p1.correct;
      document.getElementById('p1-score').textContent = p1.score;

      document.getElementById('p2-tile-badge').textContent = `Kotak ${p2.pos}/25`;
      document.getElementById('p2-rolls').textContent = p2.rolls;
      document.getElementById('p2-correct').textContent = p2.correct;
      document.getElementById('p2-score').textContent = p2.score;

      // Sorot kartu pemain yang sedang mendapat giliran
      const cardP1 = document.getElementById('card-p1');
      const cardP2 = document.getElementById('card-p2');
      const turnBanner = document.getElementById('turn-banner');
      const turnAvatar = document.getElementById('turn-avatar');
      const turnName = document.getElementById('turn-player-name');
      const turnBadge = document.getElementById('turn-badge');

      if (active.id === 0) {
        cardP1.className = 'bg-white rounded-2xl p-3.5 border-4 border-rose-500 shadow-md scale-[1.02] transition-all';
        cardP2.className = 'bg-white rounded-2xl p-3.5 border-4 border-slate-200 shadow-sm opacity-75 transition-all';

        turnBanner.className = 'rounded-2xl p-3.5 border-4 transition-all duration-300 shadow-md flex items-center justify-between bg-rose-50 border-rose-400';
        turnAvatar.className = 'w-11 h-11 rounded-2xl bg-rose-500 text-white flex items-center justify-center text-xl font-bold shadow';
        turnAvatar.textContent = '🔴';
        turnName.className = 'text-lg sm:text-xl font-extrabold text-rose-700 leading-tight';
        turnBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-rose-500 text-white shadow-sm animate-pulse';
      } else {
        cardP2.className = 'bg-white rounded-2xl p-3.5 border-4 border-sky-500 shadow-md scale-[1.02] transition-all';
        cardP1.className = 'bg-white rounded-2xl p-3.5 border-4 border-slate-200 shadow-sm opacity-75 transition-all';

        turnBanner.className = 'rounded-2xl p-3.5 border-4 transition-all duration-300 shadow-md flex items-center justify-between bg-sky-50 border-sky-400';
        turnAvatar.className = 'w-11 h-11 rounded-2xl bg-sky-500 text-white flex items-center justify-center text-xl font-bold shadow';
        turnAvatar.textContent = '🔵';
        turnName.className = 'text-lg sm:text-xl font-extrabold text-sky-700 leading-tight';
        turnBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-sky-500 text-white shadow-sm animate-pulse';
      }

      turnName.textContent = active.name;
      turnBadge.textContent = gameState.isBusy ? 'Sedang Jalan...' : 'Siap Kocok!';
      document.getElementById('btn-roll').disabled = gameState.isBusy;
    }

    function handleRollDice() {
      if (gameState.isBusy) return;
      gameState.isBusy = true;
      updateHUD();

      const activePlayer = gameState.players[gameState.currentPlayerIndex];
      activePlayer.rolls += 1;
      updateHUD();

      const diceBox = document.getElementById('dice-box');
      const statusText = document.getElementById('dice-status-text');
      diceBox.classList.add('dice-rolling');
      statusText.textContent = `${activePlayer.name} sedang mengocok dadu...`;
      SoundFX.roll();

      // Animasi acak angka dadu sebelum berhenti
      let ticks = 0;
      const rollInterval = setInterval(() => {
        renderDiceFace(Math.floor(Math.random() * 6) + 1);
        ticks++;
        if (ticks >= 8) {
          clearInterval(rollInterval);
          diceBox.classList.remove('dice-rolling');

          const finalRoll = Math.floor(Math.random() * 6) + 1;
          renderDiceFace(finalRoll);
          statusText.textContent = `Dadu berhenti di angka ${finalRoll}! Melangkah ${finalRoll} petak...`;
          setLog(`🎲 ${activePlayer.name} melempar dadu angka ${finalRoll}.`);

          movePlayerStepByStep(activePlayer, finalRoll);
        }
      }, 75);
    }

    function movePlayerStepByStep(player, steps) {
      let remaining = steps;

      const stepInterval = setInterval(() => {
        if (remaining > 0 && player.pos < TOTAL_TILES) {
          player.pos += 1;
          remaining -= 1;
          SoundFX.step();
          updatePawnsPosition();
          updateHUD();
        } else {
          clearInterval(stepInterval);
          evaluateLandingTile(player);
        }
      }, 270);
    }

    function evaluateLandingTile(player) {
      // Cek apakah pemain sudah mencapai Kotak 25 (Finish)
      if (player.pos >= TOTAL_TILES) {
        player.pos = TOTAL_TILES;
        player.score += 500; // Bonus kemenangan mencapai puncak
        updatePawnsPosition();
        updateHUD();
        setTimeout(() => triggerGameOver(player), 450);
        return;
      }

      // Cek apakah mendarat di Tangga Untung, Ular Rugi, atau Kotak Biasa
      if (LADDERS[player.pos] !== undefined) {
        const dest = LADDERS[player.pos];
        openQuizModal(player, 'ladder', player.pos, dest);
      } else if (SNAKES[player.pos] !== undefined) {
        const dest = SNAKES[player.pos];
        openQuizModal(player, 'snake', player.pos, dest);
      } else {
        openQuizModal(player, 'normal', player.pos, player.pos);
      }
    }

    /* ===========================================================
       9. SISTEM KUIS INTERAKTIF HUKUM EKONOMI (MODAL)
       =========================================================== */
    function getNextQuestion() {
      if (gameState.usedQuestionIndices.length >= QUESTION_BANK.length) {
        gameState.usedQuestionIndices = []; // Reset rotasi jika semua 28 soal sudah terpakai
      }
      let idx;
      do {
        idx = Math.floor(Math.random() * QUESTION_BANK.length);
      } while (gameState.usedQuestionIndices.includes(idx));

      gameState.usedQuestionIndices.push(idx);
      return QUESTION_BANK[idx];
    }

    function openQuizModal(player, type, currentTile, targetTile) {
      const qData = getNextQuestion();
      gameState.pendingQuizContext = {
        player,
        type,
        currentTile,
        targetTile,
        questionData: qData,
        answeredCorrectly: false
      };

      const modal = document.getElementById('modal-quiz');
      const contextBadge = document.getElementById('quiz-context-badge');
      const topicBadge = document.getElementById('quiz-topic-badge');
      const eventDesc = document.getElementById('quiz-event-desc');
      const questionEl = document.getElementById('quiz-question');
      const optionsContainer = document.getElementById('quiz-options');
      const feedbackBox = document.getElementById('quiz-feedback');

      feedbackBox.classList.add('hidden');
      topicBadge.textContent = `📚 ${qData.topic}`;
      questionEl.textContent = qData.question;

      // Sesuaikan tampilan badge & deskripsi tantangan berdasarkan jenis kotak
      if (type === 'ladder') {
        contextBadge.className = 'px-3 py-1 rounded-full text-xs sm:text-sm font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-400';
        contextBadge.textContent = `⭐ TANGGA UNTUNG: Kotak ${currentTile} ➔ ${targetTile}`;
        eventDesc.className = 'p-3 rounded-2xl bg-emerald-50 border-2 border-emerald-200 text-xs sm:text-sm font-semibold text-emerald-900 mb-4';
        eventDesc.textContent = `🚀 Peluang Emas ${player.name}! Jawab benar untuk naik tangga menuju Kotak ${targetTile} (+250 Poin)!`;
      } else if (type === 'snake') {
        contextBadge.className = 'px-3 py-1 rounded-full text-xs sm:text-sm font-extrabold bg-rose-100 text-rose-800 border border-rose-400';
        contextBadge.textContent = `⭐ ULAR RUGI: Kotak ${currentTile} ➔ ${targetTile}`;
        eventDesc.className = 'p-3 rounded-2xl bg-rose-50 border-2 border-rose-200 text-xs sm:text-sm font-semibold text-rose-900 mb-4';
        eventDesc.textContent = `⚠️ Awas Risiko Rugi ${player.name}! Jawab benar untuk bertahan di Kotak ${currentTile}. Jika salah, merosot turun ke Kotak ${targetTile}!`;
      } else {
        contextBadge.className = 'px-3 py-1 rounded-full text-xs sm:text-sm font-extrabold bg-indigo-100 text-indigo-800 border border-indigo-300';
        contextBadge.textContent = `💡 KUIS JURAGAN: Kotak ${currentTile}`;
        eventDesc.className = 'p-3 rounded-2xl bg-indigo-50 border-2 border-indigo-200 text-xs sm:text-sm font-semibold text-indigo-900 mb-4';
        eventDesc.textContent = `🧠 Tantangan Pengetahuan ${player.name}! Jawab benar untuk mengamankan posisi (+100 Poin). Jika salah, mundur 1 kotak!`;
      }

      // Render 4 pilihan jawaban (A, B, C, D)
      const letters = ['A', 'B', 'C', 'D'];
      optionsContainer.innerHTML = '';
      qData.options.forEach((optText, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-3d w-full text-left p-3 sm:p-3.5 rounded-2xl bg-slate-50 hover:bg-indigo-50 border-2 border-b-4 border-slate-300 hover:border-indigo-400 font-semibold text-sm sm:text-base text-slate-800 flex items-start gap-3 transition-all';
        btn.innerHTML = `
          <span class="w-7 h-7 rounded-xl bg-indigo-100 text-indigo-700 font-extrabold text-sm flex items-center justify-center shrink-0 mt-0.5">${letters[idx]}</span>
          <span class="flex-1">${optText}</span>
        `;
        btn.onclick = () => handleQuizAnswer(idx);
        optionsContainer.appendChild(btn);
      });

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function handleQuizAnswer(selectedIndex) {
      const ctx = gameState.pendingQuizContext;
      if (!ctx) return;

      const isCorrect = selectedIndex === ctx.questionData.correctIndex;
      ctx.answeredCorrectly = isCorrect;

      // Kunci semua tombol pilihan dan sorot jawaban benar vs salah
      const optionButtons = document.getElementById('quiz-options').querySelectorAll('button');
      optionButtons.forEach((btn, idx) => {
        btn.disabled = true;
        if (idx === ctx.questionData.correctIndex) {
          btn.className = 'w-full text-left p-3 sm:p-3.5 rounded-2xl bg-emerald-100 border-2 border-b-4 border-emerald-500 font-bold text-sm sm:text-base text-emerald-950 flex items-start gap-3';
        } else if (idx === selectedIndex && !isCorrect) {
          btn.className = 'w-full text-left p-3 sm:p-3.5 rounded-2xl bg-rose-100 border-2 border-b-4 border-rose-500 font-bold text-sm sm:text-base text-rose-950 flex items-start gap-3';
        } else {
          btn.className = 'w-full text-left p-3 sm:p-3.5 rounded-2xl bg-slate-100 border-2 border-slate-200 opacity-50 font-medium text-sm sm:text-base text-slate-500 flex items-start gap-3';
        }
      });

      const feedbackBox = document.getElementById('quiz-feedback');
      const feedbackIcon = document.getElementById('quiz-feedback-icon');
      const feedbackTitle = document.getElementById('quiz-feedback-title');
      const explanationEl = document.getElementById('quiz-explanation');

      explanationEl.textContent = ctx.questionData.explanation;
      feedbackBox.classList.remove('hidden');

      if (isCorrect) {
        SoundFX.correct();
        ctx.player.correct += 1;
        feedbackBox.className = 'mt-4 p-4 rounded-2xl border-2 bg-emerald-50 border-emerald-400 text-emerald-950 animate-pop';
        feedbackIcon.textContent = '🎉';
        feedbackTitle.textContent = 'Tepat Sekali! Jawaban Benar!';
      } else {
        SoundFX.wrong();
        feedbackBox.className = 'mt-4 p-4 rounded-2xl border-2 bg-rose-50 border-rose-400 text-rose-950 animate-pop';
        feedbackIcon.textContent = '❌';
        feedbackTitle.textContent = 'Kurang Tepat! Perhatikan Pembahasannya:';
      }
    }

    function finishQuizTurn() {
      const ctx = gameState.pendingQuizContext;
      const modal = document.getElementById('modal-quiz');
      modal.classList.add('hidden');
      modal.classList.remove('flex');

      if (!ctx) return;
      const { player, type, currentTile, targetTile, answeredCorrectly } = ctx;

      if (type === 'ladder') {
        if (answeredCorrectly) {
          player.pos = targetTile;
          player.score += 250;
          SoundFX.ladder();
          updatePawnsPosition();
          setLog(`🪜 Hebat! ${player.name} menjawab benar & naik tangga untung ke Kotak ${targetTile} (+250 Poin)!`);
          showToast(`Naik Tangga Untung ke Kotak ${targetTile}! 📈`, 'success');
        } else {
          setLog(`😅 ${player.name} salah menjawab sehingga gagal naik tangga di Kotak ${currentTile}.`);
          showToast('Gagal naik tangga! Tetap bertahan.', 'warning');
        }
      } else if (type === 'snake') {
        if (answeredCorrectly) {
          player.score += 150;
          setLog(`🛡️ Keren! ${player.name} menjawab benar dan berhasil menangkal Ular Rugi di Kotak ${currentTile} (+150 Poin)!`);
          showToast('Berhasil menangkal Ular Rugi! 🛡️', 'success');
        } else {
          player.pos = targetTile;
          SoundFX.snake();
          updatePawnsPosition();
          setLog(`🐍 Aduh! ${player.name} salah menjawab dan meluncur turun mengikuti Ular Rugi ke Kotak ${targetTile}!`);
          showToast(`Tergelincir Ular Rugi ke Kotak ${targetTile}! 📉`, 'error');
        }
      } else {
        if (answeredCorrectly) {
          player.score += 100;
          setLog(`✅ ${player.name} menjawab benar di Kotak ${currentTile} (+100 Poin).`);
        } else {
          if (player.pos > 1) {
            player.pos -= 1;
            updatePawnsPosition();
          }
          setLog(`❌ ${player.name} salah menjawab dan mundur 1 langkah ke Kotak ${player.pos}.`);
          showToast(`Mundur 1 langkah ke Kotak ${player.pos}`, 'warning');
        }
      }

      updateHUD();

      // Cek jika setelah naik tangga langsung mencapai Kotak 25
      if (player.pos >= TOTAL_TILES) {
        player.pos = TOTAL_TILES;
        player.score += 500;
        updatePawnsPosition();
        updateHUD();
        setTimeout(() => triggerGameOver(player), 450);
        return;
      }

      // Ganti giliran ke pemain berikutnya
      gameState.currentPlayerIndex = gameState.currentPlayerIndex === 0 ? 1 : 0;
      gameState.isBusy = false;
      gameState.pendingQuizContext = null;

      const nextPlayer = gameState.players[gameState.currentPlayerIndex];
      document.getElementById('dice-status-text').textContent = `Giliran ${nextPlayer.name}! Tekan kocok dadu.`;
      updateHUD();
    }

    /* ===========================================================
       10. GAME OVER, KONFETI & PENYIMPANAN LEADERBOARD
       =========================================================== */
    function triggerGameOver(winner) {
      SoundFX.win();
      launchConfetti();

      // Hitung bonus efisiensi lemparan (semakin sedikit lemparan, semakin tinggi skor)
      const efficiencyBonus = Math.max(100, (30 - winner.rolls) * 25);
      winner.score += efficiencyBonus;

      const totalMatchRolls = gameState.players[0].rolls + gameState.players[1].rolls;

      document.getElementById('winner-name').textContent = `${winner.name} (${winner.color === 'red' ? 'Merah' : 'Biru'})`;
      document.getElementById('winner-team').textContent = gameState.team;
      document.getElementById('stat-winner-rolls').textContent = winner.rolls;
      document.getElementById('stat-winner-correct').textContent = winner.correct;
      document.getElementById('stat-winner-score').textContent = winner.score;
      document.getElementById('stat-total-match-rolls').textContent =
        `Total lemparan dadu seluruh pertandingan: ${totalMatchRolls} kali`;

      saveToLeaderboard({
        name: winner.name,
        team: gameState.team,
        score: winner.score,
        rolls: winner.rolls,
        correct: winner.correct,
        date: new Date().toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })
      });

      showScreen('gameover');
    }

    function launchConfetti() {
      const colors = ['#EF4444', '#3B82F6', '#10B981', '#F59E0B', '#8B5CF6', '#EC4899'];
      for (let i = 0; i < 48; i++) {
        const conf = document.createElement('div');
        conf.className = 'confetti rounded-sm';
        conf.style.left = `${Math.random() * 100}vw`;
        conf.style.width = `${8 + Math.random() * 8}px`;
        conf.style.height = `${8 + Math.random() * 8}px`;
        conf.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
        conf.style.animationDuration = `${2.2 + Math.random() * 2}s`;
        conf.style.animationDelay = `${Math.random() * 0.6}s`;
        document.body.appendChild(conf);
        setTimeout(() => conf.remove(), 4800);
      }
    }

    function getLeaderboardData() {
      try {
        const raw = localStorage.getItem(LEADERBOARD_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        }
      } catch (e) {
        // Fallback jika localStorage diblokir
      }

      // Data contoh awal agar podium 3 besar langsung tampil menarik
      return [
        { name: 'Siti Rahma', team: 'Kelas 8B - SMPN 1 Nusantara', score: 1350, rolls: 7, correct: 6, date: 'Contoh' },
        { name: 'Dimas Pratama', team: 'Kelas 8A - SMPN 2 Harapan', score: 1180, rolls: 9, correct: 5, date: 'Contoh' },
        { name: 'Aulia Putri', team: 'Kelas 8C - SMPN 5 Merdeka', score: 1020, rolls: 10, correct: 4, date: 'Contoh' }
      ];
    }

    function saveToLeaderboard(entry) {
      try {
        const list = getLeaderboardData();
        list.push(entry);
        // Urutkan berdasarkan skor tertinggi, lalu jumlah lemparan paling sedikit
        list.sort((a, b) => b.score - a.score || a.rolls - b.rolls);
        const top15 = list.slice(0, 15);
        localStorage.setItem(LEADERBOARD_KEY, JSON.stringify(top15));
      } catch (e) {
        showToast('Tidak dapat menyimpan ke penyimpanan lokal browser.', 'warning');
      }
    }

    function renderLeaderboard() {
      const data = getLeaderboardData();
      data.sort((a, b) => b.score - a.score || a.rolls - b.rolls);

      const podiumContainer = document.getElementById('podium-container');
      const listContainer = document.getElementById('leaderboard-list');

      // Susun Podium: Juara 2 (kiri), Juara 1 (tengah), Juara 3 (kanan)
      const podiumOrder = [
        { rank: 2, item: data[1], height: 'h-24 sm:h-28', bg: 'from-slate-200 to-slate-300 border-slate-400', medal: '🥈' },
        { rank: 1, item: data[0], height: 'h-32 sm:h-36', bg: 'from-amber-200 to-yellow-400 border-amber-500', medal: '🥇' },
        { rank: 3, item: data[2], height: 'h-20 sm:h-24', bg: 'from-orange-200 to-amber-300 border-orange-400', medal: '🥉' }
      ];

      podiumContainer.innerHTML = '';
      podiumOrder.forEach(slot => {
        const div = document.createElement('div');
        div.className = 'flex flex-col items-center text-center';
        if (slot.item) {
          div.innerHTML = `
            <span class="text-2xl sm:text-3xl mb-1">${slot.medal}</span>
            <p class="font-extrabold text-xs sm:text-sm text-slate-800 truncate w-full px-1">${slot.item.name}</p>
            <p class="text-[10px] sm:text-xs font-semibold text-slate-500 truncate w-full px-1 mb-1.5">${slot.item.team}</p>
            <div class="w-full ${slot.height} rounded-t-2xl bg-gradient-to-b ${slot.bg} border-t-4 border-x-4 flex flex-col items-center justify-center p-1 shadow-inner">
              <span class="font-extrabold text-sm sm:text-base text-slate-900">${slot.item.score} pts</span>
              <span class="text-[10px] font-bold text-slate-700">🎲 ${slot.item.rolls}x</span>
            </div>
          `;
        } else {
          div.innerHTML = `
            <span class="text-2xl opacity-30 mb-1">${slot.medal}</span>
            <div class="w-full ${slot.height} rounded-t-2xl bg-slate-100 border-t-2 border-x-2 border-slate-200 flex items-center justify-center text-xs text-slate-400 font-bold">
              Kosong
            </div>
          `;
        }
        podiumContainer.appendChild(div);
      });

      // Render Daftar Lengkap
      listContainer.innerHTML = '';
      if (data.length === 0) {
        listContainer.innerHTML = `<p class="p-4 text-center text-sm text-slate-500">Belum ada skor tercatat.</p>`;
        return;
      }

      data.forEach((entry, idx) => {
        const row = document.createElement('div');
        row.className = 'px-4 py-3 flex items-center justify-between gap-2 bg-white hover:bg-amber-50/60 transition-colors';
        row.innerHTML = `
          <div class="flex items-center gap-3 min-w-0">
            <span class="w-7 h-7 rounded-xl bg-amber-100 text-amber-800 font-extrabold text-xs flex items-center justify-center shrink-0">
              #${idx + 1}
            </span>
            <div class="min-w-0">
              <p class="font-bold text-sm text-slate-800 truncate">${entry.name}</p>
              <p class="text-xs font-medium text-slate-500 truncate">${entry.team} • ${entry.date || ''}</p>
            </div>
          </div>
          <div class="text-right shrink-0">
            <p class="font-extrabold text-sm text-emerald-600">${entry.score} Poin</p>
            <p class="text-[11px] font-semibold text-slate-500">🎲 ${entry.rolls} lemparan</p>
          </div>
        `;
        listContainer.appendChild(row);
      });
    }

    function confirmClearLeaderboard() {
      showConfirmModal(
        'Reset Data Leaderboard?',
        'Semua catatan pemenang yang tersimpan di perangkat ini akan dihapus.',
        () => {
          localStorage.removeItem(LEADERBOARD_KEY);
          renderLeaderboard();
          showToast('Data leaderboard berhasil direset!', 'info');
        }
      );
    }

    // Inisialisasi tampilan awal dadu saat halaman dimuat
    window.addEventListener('DOMContentLoaded', () => {
      renderDiceFace(6);
    });
  </script>
</body>
</html>
