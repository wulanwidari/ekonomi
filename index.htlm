      <!-- Question Text -->
      <h3 id="quiz-question" class="text-base sm:text-lg font-bold text-slate-800 leading-snug mb-4">
        Pertanyaan akan muncul di sini...
      </h3>

      <!-- Multiple Choice Options -->
      <div id="quiz-options" class="space-y-2.5">
