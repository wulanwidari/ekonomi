<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Juragan Ekonomi: Edisi Ular Tangga (IPS Hukum Ekonomi)</title>

  <!-- Google Fonts: Fredoka -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            fredoka: ['Fredoka', 'sans-serif'],
          },
          animation: {
            'bounce-slow': 'bounce 2.2s infinite',
            'float': 'float 3s ease-in-out infinite',
            'pop': 'pop 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-6px)' },
            },
            pop: {
              '0%': { transform: 'scale(0.8)', opacity: '0' },
              '100%': { transform: 'scale(1)', opacity: '1' },
            }
          }
        }
      }
    };
  </script>

  <style>
    /* Custom Game Styling & Smooth Transitions */
    body {
      font-family: 'Fredoka', sans-serif;
      background-color: #FEF9C3;
      background-image:
        radial-gradient(#FDE047 1.75px, transparent 1.75px),
        radial-gradient(#FDBA74 1.75px, #FEF9C3 1.75px);
      background-size: 44px 44px;
      background-position: 0 0, 22px 22px;
      overflow-x: hidden;
      user-select: none;
    }

    /* Chunky 3D Arcade / Boardgame Button Style */
    .btn-3d {
      transition: all 0.12s ease;
    }
    .btn-3d:active:not(:disabled) {
      transform: translateY(4px);
      border-bottom-width: 2px;
    }
    .btn-3d:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
    }

    /* Dice Rolling Keyframes */
    @keyframes diceShake {
      0% { transform: rotate(0deg) scale(1); }
      20% { transform: rotate(-18deg) scale(1.12); }
      40% { transform: rotate(18deg) scale(1.15); }
      60% { transform: rotate(-14deg) scale(1.1); }
      80% { transform: rotate(14deg) scale(1.12); }
      100% { transform: rotate(0deg) scale(1); }
    }
    .dice-rolling {
      animation: diceShake 0.55s ease-in-out infinite;
    }

    /* Pawn Hop Transition */
    .pawn-piece {
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      filter: drop-shadow(0 4px 4px rgba(0, 0, 0, 0.35));
    }

    /* Confetti Particle */
    @keyframes confettiFall {
      0% { transform: translateY(-10vh) rotate(0deg); opacity: 1; }
      100% { transform: translateY(105vh) rotate(720deg); opacity: 0.2; }
    }
    .confetti {
      position: fixed;
      top: -10px;
      z-index: 60;
      pointer-events: none;
      animation: confettiFall linear forwards;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #FEF3C7;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb {
      background: #F59E0B;
      border-radius: 999px;
    }
  </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col">

  <!-- =========================================================
       TOAST NOTIFICATION CONTAINER (Pengganti alert())
       ========================================================= -->
  <div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 w-11/12 max-w-md pointer-events-none"></div>

  <!-- =========================================================
       CUSTOM CONFIRMATION MODAL (Pengganti confirm())
       ========================================================= -->
  <div id="modal-confirm" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="bg-white border-4 border-amber-400 rounded-3xl max-w-sm w-full p-6 shadow-2xl animate-pop text-center">
      <div class="w-16 h-16 mx-auto mb-3 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center text-3xl">
        ⚠️
      </div>
      <h3 id="confirm-title" class="text-xl font-bold text-slate-800 mb-2">Konfirmasi</h3>
      <p id="confirm-message" class="text-slate-600 text-sm mb-6">Apakah kamu yakin ingin melanjutkan?</p>
      <div class="flex gap-3">
        <button id="confirm-cancel" class="btn-3d flex-1 py-2.5 px-4 rounded-2xl bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold border-b-4 border-slate-400">
          Batal
        </button>
        <button id="confirm-ok" class="btn-3d flex-1 py-2.5 px-4 rounded-2xl bg-rose-500 hover:bg-rose-600 text-white font-bold border-b-4 border-rose-700">
          Ya, Lanjut
        </button>
      </div>
    </div>
  </div>

  <!-- =========================================================
       HOW TO PLAY MODAL (Aturan Bermain)
       ========================================================= -->
  <div id="modal-rules" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="bg-white border-4 border-indigo-400 rounded-3xl max-w-lg w-full p-6 shadow-2xl animate-pop max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-2xl font-bold text-indigo-700 flex items-center gap-2">
          <span>📘</span> Panduan Juragan Ekonomi
        </h3>
        <button onclick="toggleRulesModal(false)" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold text-lg">✕</button>
      </div>
      <div class="space-y-3 text-sm sm:text-base text-slate-700">
        <div class="p-3 rounded-2xl bg-amber-50 border-2 border-amber-200 flex gap-3 items-start">
          <span class="text-2xl">🎲</span>
          <div>
            <p class="font-bold text-amber-800">1. Lempar Dadu & Melangkah</p>
            <p>Pemain 1 (Merah) dan Pemain 2 (Biru) bergantian mengocok dadu untuk melangkah di papan zig-zag dari kotak <b>1</b> menuju kotak <b>25 (Juragan Sukses)</b>.</p>
          </div>
        </div>
        <div class="p-3 rounded-2xl bg-indigo-50 border-2 border-indigo-200 flex gap-3 items-start">
          <span class="text-2xl">💡</span>
          <div>
            <p class="font-bold text-indigo-800">2. Tantangan Kuis Hukum Ekonomi</p>
            <p>Setiap mendarat di sebuah kotak, muncul soal IPS tentang <b>Hukum Permintaan, Penawaran, Ceteris Paribus, Gossen I & II, Engel, Kurva, & Keseimbangan Pasar</b>.</p>
          </div>
        </div>
        <div class="p-3 rounded-2xl bg-emerald-50 border-2 border-emerald-200 flex gap-3 items-start">
          <span class="text-2xl">🪜</span>
          <div>
            <p class="font-bold text-emerald-800">3. Kotak Spesial Tangga Untung (⭐ 📈)</p>
            <p>Jika mendarat di pangkal tangga (Kotak <b>3, 6, 12</b>) dan menjawab kuis dengan <b>BENAR</b>, pion langsung naik tangga menuju keuntungan besar!</p>
          </div>
        </div>
        <div class="p-3 rounded-2xl bg-rose-50 border-2 border-rose-200 flex gap-3 items-start">
          <span class="text-2xl">🐍</span>
          <div>
            <p class="font-bold text-rose-800">4. Kotak Spesial Ular Rugi (⭐ 📉)</p>
            <p>Jika mendarat di kepala ular (Kotak <b>14, 19, 24</b>), jawab kuis dengan <b>BENAR</b> untuk menangkal risiko rugi! Jika salah, pion merosot turun mengikuti ekor ular.</p>
          </div>
        </div>
      </div>
      <button onclick="toggleRulesModal(false)" class="btn-3d mt-5 w-full py-3 rounded-2xl bg-indigo-500 hover:bg-indigo-600 text-white font-bold text-lg border-b-4 border-indigo-700">
        Siap Mengerti! 👍
      </button>
    </div>
  </div>

  <!-- =========================================================
       SCREEN 1: START SCREEN (HALAMAN AWAL)
       ========================================================= -->
  <main id="screen-start" class="flex-1 flex items-center justify-center p-4 sm:p-6">
    <div class="w-full max-w-xl bg-white/95 backdrop-blur border-4 border-amber-400 rounded-[2rem] p-6 sm:p-8 shadow-2xl relative overflow-hidden">
      <!-- Decorative Corner Coins -->
      <div class="absolute -top-6 -right-6 w-24 h-24 bg-amber-200/60 rounded-full pointer-events-none"></div>
      <div class="absolute -bottom-8 -left-8 w-28 h-28 bg-emerald-200/50 rounded-full pointer-events-none"></div>

      <!-- Header Branding -->
      <div class="text-center mb-6 relative">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 border-2 border-amber-300 text-amber-800 text-xs sm:text-sm font-bold mb-3 animate-float">
          <span>📊</span> MEDIA PEMBELAJARAN IPS • HUKUM EKONOMI
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-amber-500 to-rose-500 tracking-tight leading-tight">
          JURAGAN EKONOMI
        </h1>
        <p class="text-lg sm:text-xl font-bold text-indigo-600 mt-0.5">
          Edisi Ular Tangga 🎲📈
        </p>
      </div>

      <!-- Player Registration Form -->
      <form id="start-form" class="space-y-4 relative">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Player 1 (Red) -->
          <div class="p-3.5 rounded-2xl bg-rose-50 border-2 border-rose-300">
            <label for="input-p1" class="flex items-center gap-2 text-sm font-bold text-rose-700 mb-1.5">
              <span class="w-6 h-6 rounded-full bg-rose-500 text-white inline-flex items-center justify-center text-xs shadow">1</span>
              Pemain 1 (Merah)
            </label>
            <input
              id="input-p1"
              type="text"
              maxlength="18"
              placeholder="Contoh: Raka"
              class="w-full px-3.5 py-2.5 rounded-xl bg-white border-2 border-rose-200 focus:border-rose-500 focus:outline-none font-semibold text-slate-800 placeholder:text-slate-400"
              required
            />
          </div>

          <!-- Player 2 (Blue) -->
          <div class="p-3.5 rounded-2xl bg-sky-50 border-2 border-sky-300">
            <label for="input-p2" class="flex items-center gap-2 text-sm font-bold text-sky-700 mb-1.5">
              <span class="w-6 h-6 rounded-full bg-sky-500 text-white inline-flex items-center justify-center text-xs shadow">2</span>
              Pemain 2 (Biru)
            </label>
            <input
              id="input-p2"
              type="text"
              maxlength="18"
              placeholder="Contoh: Nabila"
              class="w-full px-3.5 py-2.5 rounded-xl bg-white border-2 border-sky-200 focus:border-sky-500 focus:outline-none font-semibold text-slate-800 placeholder:text-slate-400"
              required
            />
          </div>
        </div>

        <!-- Team / Class & School -->
        <div class="p-3.5 rounded-2xl bg-amber-50 border-2 border-amber-300">
          <label for="input-team" class="flex items-center gap-2 text-sm font-bold text-amber-800 mb-1.5">
            <span>🏫</span> Kelas & Sekolah (Identitas Tim)
          </label>
          <input
            id="input-team"
            type="text"
            maxlength="36"
            placeholder="Contoh: Kelas 8A - SMPN 1 Nusantara"
            class="w-full px-3.5 py-2.5 rounded-xl bg-white border-2 border-amber-200 focus:border-amber-500 focus:outline-none font-semibold text-slate-800 placeholder:text-slate-400"
            required
          />
        </div>

        <!-- Action Buttons -->
        <div class="pt-2 space-y-3">
          <button
            type="submit"
            class="btn-3d w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-bold text-lg sm:text-xl border-b-4 border-emerald-700 shadow-lg flex items-center justify-center gap-2"
          >
            <span>MULAI PERMAINAN</span>
            <span>🚀</span>
          </button>

          <div class="grid grid-cols-2 gap-3">
            <button
              type="button"
              onclick="showScreen('leaderboard')"
              class="btn-3d py-3 px-4 rounded-2xl bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold text-sm sm:text-base border-b-4 border-amber-600 flex items-center justify-center gap-1.5"
            >
              <span>🏆</span>
              <span>Leaderboard</span>
            </button>
            <button
              type="button"
              onclick="toggleRulesModal(true)"
              class="btn-3d py-3 px-4 rounded-2xl bg-indigo-100 hover:bg-indigo-200 text-indigo-800 font-bold text-sm sm:text-base border-b-4 border-indigo-300 flex items-center justify-center gap-1.5"
            >
              <span>📘</span>
              <span>Aturan Main</span>
            </button>
          </div>
        </div>
      </form>
    </div>
  </main>

  <!-- =========================================================
       SCREEN 2: GAME SCREEN (HALAMAN PERMAINAN)
       ========================================================= -->
  <section id="screen-game" class="hidden flex-1 flex flex-col max-w-6xl w-full mx-auto p-3 sm:p-5 gap-3 sm:gap-4">
    <!-- Top Navigation Bar -->
    <header class="bg-white/95 border-4 border-amber-300 rounded-2xl px-4 py-2.5 shadow-md flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2.5">
        <span class="text-2xl">💹</span>
        <div>
          <h2 class="font-bold text-base sm:text-lg text-slate-800 leading-none">Juragan Ekonomi</h2>
          <p id="hud-team" class="text-xs font-semibold text-amber-700 mt-0.5">Kelas - Sekolah</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="btn-sound"
          onclick="toggleMute()"
          title="Suara Efek"
          class="btn-3d px-3 py-2 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-800 font-bold text-sm border-b-4 border-amber-300"
        >
          🔊
        </button>
        <button
          onclick="toggleRulesModal(true)"
          title="Aturan Main"
          class="btn-3d px-3 py-2 rounded-xl bg-indigo-100 hover:bg-indigo-200 text-indigo-800 font-bold text-sm border-b-4 border-indigo-300"
        >
          📘
        </button>
        <button
          onclick="confirmExitGame()"
          title="Keluar ke Menu"
          class="btn-3d px-3 py-2 rounded-xl bg-rose-100 hover:bg-rose-200 text-rose-700 font-bold text-sm border-b-4 border-rose-300"
        >
          🏠 Menu
        </button>
      </div>
    </header>

    <!-- Main Game Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start flex-1">

      <!-- Left / Center: 5x5 Zig-Zag Game Board -->
      <div class="lg:col-span-7 flex flex-col items-center">
        <div class="w-full max-w-[490px] bg-white p-3 sm:p-4 rounded-[2rem] border-4 border-amber-400 shadow-xl relative">
          <!-- Board Wrapper with Relative Positioning for SVG Overlay -->
          <div id="board-wrapper" class="relative w-full aspect-square rounded-2xl overflow-hidden border-4 border-amber-600 bg-amber-100">
            <!-- 5x5 Grid Cells -->
            <div id="board-grid" class="grid grid-cols-5 grid-rows-5 w-full h-full"></div>

            <!-- SVG Overlay for Snakes & Ladders -->
            <svg id="board-svg" class="absolute inset-0 w-full h-full pointer-events-none z-10"></svg>

            <!-- Pawn Layer -->
            <div id="pawn-layer" class="absolute inset-0 pointer-events-none z-20"></div>
          </div>

          <!-- Legend Bar Under Board -->
          <div class="mt-3 grid grid-cols-2 gap-2 text-xs font-bold">
            <div class="px-2.5 py-1.5 rounded-xl bg-emerald-50 border-2 border-emerald-200 text-emerald-800 flex items-center gap-1.5">
              <span>🪜</span>
              <span>Tangga Untung: 3→11, 6→15, 12→22</span>
            </div>
            <div class="px-2.5 py-1.5 rounded-xl bg-rose-50 border-2 border-rose-200 text-rose-800 flex items-center gap-1.5">
              <span>🐍</span>
              <span>Ular Rugi: 14→4, 19→9, 24→16</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Player Status, Turn Indicator, & Interactive Dice -->
      <div class="lg:col-span-5 flex flex-col gap-3.5 w-full max-w-[490px] mx-auto lg:max-w-none">

        <!-- Active Turn Banner -->
        <div id="turn-banner" class="rounded-2xl p-3.5 border-4 transition-all duration-300 shadow-md flex items-center justify-between bg-rose-50 border-rose-400">
          <div class="flex items-center gap-3">
            <div id="turn-avatar" class="w-11 h-11 rounded-2xl bg-rose-500 text-white flex items-center justify-center text-xl font-bold shadow">
              🔴
            </div>
            <div>
              <span class="text-xs uppercase tracking-wider font-bold text-slate-500 block">Giliran Bermain</span>
              <h3 id="turn-player-name" class="text-lg sm:text-xl font-extrabold text-rose-700 leading-tight">Pemain 1</h3>
            </div>
          </div>
          <span id="turn-badge" class="px-3 py-1 rounded-full text-xs font-bold bg-rose-500 text-white shadow-sm animate-pulse">
            Siap Kocok!
          </span>
        </div>

        <!-- Players Score & Position Cards -->
        <div class="grid grid-cols-2 gap-3">
          <!-- Player 1 Card -->
          <div id="card-p1" class="bg-white rounded-2xl p-3.5 border-4 border-rose-400 shadow-sm transition-all">
            <div class="flex items-center justify-between mb-2">
              <span class="px-2 py-0.5 rounded-lg bg-rose-100 text-rose-700 text-xs font-bold">🔴 Merah</span>
              <span id="p1-tile-badge" class="text-xs font-extrabold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-lg">Kotak 1/25</span>
            </div>
            <p id="p1-name-display" class="font-bold text-base text-slate-800 truncate mb-2">Pemain 1</p>
            <div class="space-y-1 text-xs font-semibold text-slate-600">
              <div class="flex justify-between">
                <span>🎲 Lemparan:</span>
                <span id="p1-rolls" class="font-bold text-slate-800">0</span>
              </div>
              <div class="flex justify-between">
                <span>✅ Kuis Benar:</span>
                <span id="p1-correct" class="font-bold text-emerald-600">0</span>
              </div>
              <div class="flex justify-between">
                <span>💰 Poin:</span>
                <span id="p1-score" class="font-bold text-amber-600">0</span>
              </div>
            </div>
          </div>

          <!-- Player 2 Card -->
          <div id="card-p2" class="bg-white rounded-2xl p-3.5 border-4 border-slate-200 shadow-sm transition-all opacity-80">
            <div class="flex items-center justify-between mb-2">
              <span class="px-2 py-0.5 rounded-lg bg-sky-100 text-sky-700 text-xs font-bold">🔵 Biru</span>
              <span id="p2-tile-badge" class="text-xs font-extrabold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-lg">Kotak 1/25</span>
            </div>
            <p id="p2-name-display" class="font-bold text-base text-slate-800 truncate mb-2">Pemain 2</p>
            <div class="space-y-1 text-xs font-semibold text-slate-600">
              <div class="flex justify-between">
                <span>🎲 Lemparan:</span>
                <span id="p2-rolls" class="font-bold text-slate-800">0</span>
              </div>
              <div class="flex justify-between">
                <span>✅ Kuis Benar:</span>
                <span id="p2-correct" class="font-bold text-emerald-600">0</span>
              </div>
              <div class="flex justify-between">
                <span>💰 Poin:</span>
                <span id="p2-score" class="font-bold text-amber-600">0</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Interactive Dice Control Card -->
        <div class="bg-white rounded-3xl p-4 sm:p-5 border-4 border-indigo-300 shadow-lg flex flex-col items-center text-center">
          <div class="flex items-center justify-center gap-5 w-full mb-3">
            <!-- Visual 3D-Styled Dice Face -->
            <div
              id="dice-box"
              onclick="handleRollDice()"
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-gradient-to-br from-white to-slate-100 border-4 border-slate-300 shadow-xl flex items-center justify-center cursor-pointer select-none"
            >
              <div id="dice-face" class="grid grid-cols-3 grid-rows-3 gap-1.5 w-14 h-14 sm:w-16 sm:h-16 p-1">
                <!-- Pips rendered via JS -->
              </div>
            </div>

            <div class="text-left flex-1">
              <p class="text-xs font-bold uppercase text-indigo-500">Kontrol Langkah</p>
              <p id="dice-status-text" class="text-sm sm:text-base font-bold text-slate-700 mt-0.5">
                Tekan tombol di bawah untuk mengocok dadu!
              </p>
            </div>
          </div>

          <button
            id="btn-roll"
            onclick="handleRollDice()"
            class="btn-3d w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 hover:from-indigo-600 hover:to-pink-600 text-white font-extrabold text-lg border-b-4 border-indigo-800 shadow-md flex items-center justify-center gap-2"
          >
            <span>🎲</span>
            <span>KOCOK DADU</span>
          </button>
        </div>

        <!-- Live Activity Ticker -->
        <div class="bg-amber-50/90 border-2 border-amber-300 rounded-2xl p-3">
          <p class="text-xs font-bold text-amber-800 mb-1 flex items-center gap-1.5">
            <span>📜</span> Catatan Transaksi Langkah:
          </p>
          <p id="game-log" class="text-xs sm:text-sm font-medium text-slate-700 leading-snug">
            Selamat datang di arena Juragan Ekonomi! Giliran pertama dimulai.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================
       INTERACTIVE QUIZ MODAL (SISTEM KUIS HUKUM EKONOMI)
       ========================================================= -->
  <div id="modal-quiz" class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-40 hidden items-center justify-center p-3 sm:p-4">
    <div class="bg-white border-4 border-indigo-500 rounded-[2rem] max-w-xl w-full p-5 sm:p-6 shadow-2xl animate-pop max-h-[92vh] overflow-y-auto">
      <!-- Top Context & Topic Badges -->
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <span id="quiz-context-badge" class="px-3 py-1 rounded-full text-xs sm:text-sm font-extrabold bg-indigo-100 text-indigo-800 border border-indigo-300">
          💡 Kuis Kotak 5
        </span>
        <span id="quiz-topic-badge" class="px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
          Hukum Permintaan
        </span>
      </div>

      <!-- Event Description Alert -->
      <div id="quiz-event-desc" class="p-3 rounded-2xl bg-slate-100 border-2 border-slate-200 text-xs sm:text-sm font-semibold text-slate-700 mb-4">
        Jawab pertanyaan berikut dengan tepat!
