        <p id="quiz-explanation" class="text-xs sm:text-sm leading-relaxed mb-3"></p>
        <button
          id="btn-quiz-continue"
          onclick="finishQuizTurn()"
          class="btn-3d w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-base border-b-4 border-indigo-900"
        >
          LANJUTKAN PERMAINAN ➡️
        </button>
      </div>
    </div>
  </div>

